{
  "name": "image-size-presets",
  "version": "1.2.3",
  "description": "Set default image sizes per note, folder, or vault with one click.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "test": "node scripts/test.mjs",
    "test:layout": "node scripts/layout-test.mjs",
    "preview": "node scripts/layout-preview.mjs",
    "lint": "eslint src",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "image",
    "image-size",
    "resize"
  ],
  "author": "auryn",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.20.5",
    "builtin-modules": "^5.5.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-plugin-obsidianmd": "^0.5.1",
    "obsidian": "^1.14.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2"
  }
}
